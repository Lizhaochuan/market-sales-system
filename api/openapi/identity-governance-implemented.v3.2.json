      "post": {
        "operationId": "createIdentityChangeRequest",
        "summary": "首位主管提交员工身份绑定或撤销申请（尚不执行）",
        "security": [
          {
            "staffBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "request_evidence_ref",
                  "request_reason_zh"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "bind",
                      "revoke"
                    ]
                  },
                  "target_staff_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "issuer": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "existing_binding_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "request_evidence_ref": {
                    "type": "string"
                  },
                  "request_reason_zh": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "操作成功（仍仅适用于隔离测试）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message",
                    "request_id",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "const": "OK"
                    },
                    "message": {
                      "type": "string"
                    },
                    "request_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id",
                        "status",
                        "target_staff_name"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "status": {
                          "type": "string",
                          "const": "pending"
                        },
                        "target_staff_name": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "身份、权限或业务审核拒绝"
          },
          "403": {
            "description": "身份、权限或业务审核拒绝"
