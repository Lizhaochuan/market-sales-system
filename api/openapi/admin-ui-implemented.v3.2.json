{
  "openapi": "3.1.0",
  "info": {
    "title": "Market Sales V3.2-02 Chinese Admin Isolated UI Extensions",
    "version": "3.2.02-isolated",
    "description": "7 V3.2-02 demo-login/list operations. Complements 14 V3.2-01 core operations; no financial/CRM write endpoints, not production."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3100",
      "description": "本机虚构演示，仅供隔离测试"
    }
  ],
  "security": [
    {
      "staffBearer": []
    }
  ],
  "paths": {
    "/api/v1/dev/login": {
      "post": {
        "operationId": "isolatedDemoLogin",
        "summary": "仅本机虚构员工演示登录",
        "description": "只允许 MS_STAGE=isolated-test，127.0.0.1，本机随机演示访问口令。正式系统禁止使用。",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "account_code",
                  "passphrase"
                ],
                "additionalProperties": false,
                "properties": {
                  "account_code": {
                    "type": "string",
                    "enum": [
                      "sales-a",
                      "sales-b",
                      "supervisor"
                    ]
                  },
                  "passphrase": {
                    "type": "string",
                    "minLength": 32
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已授权范围内的列表或演示登录结果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "request_id",
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string",
                      "const": "OK"
                    },
                    "message": {
                      "type": "string"
                    },
                    "request_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "token",
                        "display_name",
                        "role_label",
                        "account_code",
                        "expires_in_seconds",
                        "stage"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "token": {
                          "type": "string"
                        },
                        "display_name": {
                          "type": "string"
                        },
                        "role_label": {
                          "type": "string"
                        },
                        "account_code": {
                          "type": "string"
                        },
                        "expires_in_seconds": {
                          "type": "integer"
                        },
                        "stage": {
                          "type": "string",
                          "const": "isolated-test"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "演示访问口令错误"
          },
          "404": {
            "description": "未在隔离环境启用"
          }
        },
        "x-implementation-status": "isolated-test-only"
      }
    },
