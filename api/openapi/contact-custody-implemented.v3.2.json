{
  "openapi": "3.1.0",
  "info": {
    "title": "V3.2-15 Strict Auth Directory + Contact Custody Approval (Isolated)",
    "version": "3.2.15-isolated",
    "description": "Four actual strict-mode custody endpoints plus a protected auth-directory function. The historical creator and existing child/consultation/finance/lead ownership never transfer."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3100",
      "description": "Disposable fictional loopback environment"
    }
  ],
  "paths": {
    "/api/v1/contact-custody/requests": {
      "post": {
        "operationId": "requestContactCustody",
        "summary": "申请将某一联系人当前管理权交给本机构其他员工",
        "description": "Isolated strict mode only, externally verified RS256 plus current approved database identity. Application account can only EXECUTE approved business function, no raw customer table rights. No student/consultation/family/finance transfer.",
        "security": [
          {
            "signedEmployeeBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "contact_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "target_staff_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "reason_zh": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 400
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "contact_id",
                  "target_staff_id",
                  "reason_zh",
                  "evidence_ref"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "受保护数据库函数完成申请或独立审批并返回业务结果"
          },
          "403": {
            "description": "非当前管理人、申请人/接收人试图自批、不是独立主管、身份撤销、账号错配或其他越权"
          },
          "409": {
            "description": "同一防重编号冲突或申请已审批"
          },
          "422": {
            "description": "业务材料不完整、接收人不属于本机构或关系已发生变化"
          }
        },
        "x-production-ready": false,
        "x-finance-and-student-ownership-transfer": false
      },
      "get": {
        "operationId": "listContactCustodyRequests",
        "summary": "查看本人参与或有效主管有权审核的联系人交接申请",
        "security": [
          {
            "signedEmployeeBearer": []
          }
        ],
        "description": "Reads only through a separate employee-specific nonowner PostgreSQL login. Never includes proof/evidence, phone, WeChat, other children's records or consultations.",
        "responses": {
          "200": {
            "description": "中文姓名、待审状态、必要编号的最小只读列表"
          },
          "403": {
            "description": "员工签名未经批准或身份撤销"
          }
        },
        "x-production-ready": false
      }
    },
    "/api/v1/contact-custody/requests/{requestId}/decision": {
      "post": {
        "operationId": "decideContactCustody",
        "summary": "独立主管审批具体联系人交接申请",
        "description": "Isolated strict mode only, externally verified RS256 plus current approved database identity. Application account can only EXECUTE approved business function, no raw customer table rights. No student/consultation/family/finance transfer.",
        "security": [
          {
            "signedEmployeeBearer": []
          }
        ],
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "approved",
                      "rejected"
                    ]
                  },
                  "reason_zh": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 400
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "decision",
                  "reason_zh",
                  "evidence_ref"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "受保护数据库函数完成申请或独立审批并返回业务结果"
          },
          "403": {
            "description": "非当前管理人、申请人/接收人试图自批、不是独立主管、身份撤销、账号错配或其他越权"
          },
          "409": {
            "description": "同一防重编号冲突或申请已审批"
          },
          "422": {
            "description": "业务材料不完整、接收人不属于本机构或关系已发生变化"
          }
        },
        "x-production-ready": false,
        "x-finance-and-student-ownership-transfer": false
      }
    },
    "/api/v1/contact-custody/staff": {
      "get": {
        "operationId": "listContactCustodyCandidates",
        "summary": "查询同机构有效接收员工的简要中文姓名",
        "security": [
          {
            "signedEmployeeBearer": []
          }
        ],
        "description": "Reads only through a separate employee-specific nonowner PostgreSQL login. Never includes proof/evidence, phone, WeChat, other children's records or consultations.",
        "responses": {
          "200": {
            "description": "中文姓名、待审状态、必要编号的最小只读列表"
          },
          "403": {
            "description": "员工签名未经批准或身份撤销"
          }
        },
        "x-production-ready": false
      }
    }
  },
  "components": {
    "securitySchemes": {
      "signedEmployeeBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Test-only signed RS256 JWT, independently approved, resolved via nonowner function-only auth directory; not production OIDC."
      }
    }
  },
  "x-production-ready": false,
  "x-custody-operations": 4,
  "x-original-owner-audit-preserved": true,
  "x-real-financial-and-crm-writes-enabled": false
}
