{
  "openapi": "3.1.0",
  "info": {
    "title": "V3.2-09 Employee Scoped Sales Read API - Isolated Only",
    "version": "3.2.09-isolated",
    "description": "Five implemented read-only isolated HTTP routes: student, parent/contact, consultation event, lead, opportunity. Do NOT confuse with main sales CRUD or CRM financial integrations."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3200",
      "description": "仅虚构数据本机员工只读服务"
    }
  ],
  "paths": {
    "/api/v1/scoped/students": {
      "get": {
        "operationId": "listScopedStudents",
        "summary": "学生列表（仅本人负责或具体授权）",
        "description": "隔离环境只读示范。真实 JWT RS256 验签后，还要在员工专用的、非所有者数据库 LOGIN 里验证当前批准身份绑定；该角色无权读基础表或写任何财务记录。",
        "security": [
          {
            "externalEmployeeBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "当前登录员工获允许查看的业务记录",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message",
                    "request_id",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "const": "OK"
                    },
                    "message": {
                      "type": "string"
                    },
                    "request_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "items"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "maxItems": 100,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "student_id",
                              "display_name",
                              "organization_id"
                            ],
                            "properties": {
                              "student_id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "display_name": {
                                "type": "string"
                              },
                              "organization_id": {
                                "type": "string",
                                "format": "uuid"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "身份令牌缺失、错误、签名或权限校验失败"
          },
          "403": {
            "description": "员工未绑定、未批准、已离职或该数据库 LOGIN 与员工不匹配"
          },
          "404": {
            "description": "未开放接口或方法"
          },
          "500": {
            "description": "隔离环境数据库查询失败，不向客户端泄露 SQL 细节"
          }
        },
        "x-runtime-status": "isolated-local-readonly",
        "x-real-crm-write-enabled": false,
        "x-uses-employee-db-login": true
      }
    },
