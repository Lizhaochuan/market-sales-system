{
  "openapi": "3.0.3",
  "info": {
    "title": "M01 隔离渠道目录 GET 接口",
    "version": "v3.2-53-isolated",
    "description": "仅本机虚构账号测试：隔离演示及已通过双重身份检查的严格员工只读模式；生产无授权。严格员工数据库视图由 CI-only SQL 安装，未批准任何正式数据库迁移。"
  },
  "x-contract-status": "isolated-implemented",
  "x-strict-employee-mode-enabled": true,
  "x-production-integration-allowed": false,
  "x-write-operations-allowed": false,
  "servers": [
    {
      "url": "http://127.0.0.1",
      "description": "隔离演示服务（实际端口由测试分配）"
    }
  ],
  "paths": {
    "/api/v1/marketing-channels": {
      "get": {
        "summary": "读取当前虚构机构的渠道树",
        "description": "按已验证员工的数据库 SESSION_USER 绑定机构，受限账号仅能查 CI 安装的只读安全视图；演示模式仍使用独立旧查询。父渠道跨机构、层级环路或数据损坏均拒绝，不允许渠道写入。",
        "operationId": "listIsolatedMarketingChannels",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "当前机构只读渠道目录",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "OK"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "request_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "schema_version",
                        "count",
                        "root_count",
                        "effective_active_count",
                        "channels",
                        "production_integration_allowed",
                        "status"
                      ],
                      "properties": {
                        "schema_version": {
                          "type": "string",
                          "enum": [
                            "m01-isolated-channel-catalog-v1"
                          ]
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 200
                        },
                        "root_count": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 200
                        },
                        "effective_active_count": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 200
                        },
                        "channels": {
                          "type": "array",
                          "maxItems": 200,
                          "items": {
                            "type": "object",
                            "required": [
                              "channel_id",
                              "parent_channel_id",
                              "name",
                              "channel_type",
                              "status",
                              "effective_status",
                              "depth"
                            ],
                            "properties": {
                              "channel_id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "parent_channel_id": {
                                "type": "string",
                                "format": "uuid",
                                "nullable": true
                              },
                              "name": {
                                "type": "string"
                              },
                              "channel_type": {
                                "type": "string",
                                "nullable": true
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "active",
                                  "inactive"
                                ]
                              },
                              "effective_status": {
                                "type": "string",
                                "enum": [
                                  "active",
                                  "inactive",
                                  "inactive_inherited"
                                ]
                              },
                              "depth": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 16
                              }
                            }
                          }
                        },
                        "production_integration_allowed": {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "isolated_readonly_not_production"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "无有效虚构签名员工令牌"
          },
          "403": {
            "description": "未批准签名身份、错误/缺失员工数据库登录，或缺少严格数据库视图的访问权限"
          },
          "500": {
            "description": "渠道层级未通过一致性验证；通用错误不泄漏内部数据"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "x-strict-employee-db-access": "CI_ONLY_SECURITY_BARRIER_VIEW"
}
