{
  "openapi": "3.0.3",
  "info": {
    "title": "M02 隔离市场活动草稿 API",
    "version": "v3.2-67",
    "description": "Isolated fictional campaign draft creation, revisions and sales-manager-only review. Finance authorization and real spending not implemented. Read-only finance handoff preparation is not finance approval."
  },
  "x-contract-status": "isolated-implemented",
  "x-production-integration-allowed": false,
  "x-campaign-status-allowed": [
    "draft"
  ],
  "x-marketing-costs-or-allocations-created": false,
  "servers": [
    {
      "url": "http://127.0.0.1",
      "description": "本机隔离 CI"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      }
    }
  },
  "paths": {
    "/api/v1/marketing-campaigns/drafts": {
      "get": {
        "operationId": "listScopedCampaignDrafts",
        "summary": "仅本人或所属机构有效主管查看隔离活动草稿",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "最多100条经 SESSION_USER 员工机构约束的草稿；仅显示计划预算"
          },
          "403": {
            "description": "无签名身份或缺员工专用只读连接"
          },
          "500": {
            "description": "超过上限或投影损坏时拒绝全部结果"
          }
        }
      },
      "post": {
        "operationId": "createScopedCampaignDraft",
        "summary": "创建本人负责的虚构活动草稿，不执行活动或资金",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "budget_cents",
                  "channel_ids"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "starts_at": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "ends_at": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "budget_cents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000000000
                  },
                  "channel_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "创建或重放本人草稿，状态仅为 draft"
          },
          "403": {
            "description": "员工身份/受限数据库登录不一致"
          },
          "409": {
            "description": "同一防重号对应不同内容"
          },
          "422": {
            "description": "预算、时间、渠道、跨机构和停用层级不满足要求"
          },
          "500": {
            "description": "不可确定结果时拒绝返回敏感数据"
          }
        }
      }
    },
    "/api/v1/marketing-campaigns/drafts/{campaign_id}/revisions": {
      "post": {
        "operationId": "reviseOwnScopedCampaignDraft",
        "summary": "仅草稿原负责人可用当前版本安全修改虚构活动的计划字段",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "campaign_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expected_version",
                  "name",
                  "budget_cents",
                  "channel_ids"
                ],
                "properties": {
                  "expected_version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483645
                  },
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "starts_at": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "ends_at": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "budget_cents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000000000
                  },
                  "channel_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "返回草稿版本 +1 的结果；同一请求编号重放返回原版本"
          },
          "403": {
            "description": "非草稿原负责人、授权失效或跨机构"
          },
          "409": {
            "description": "版本已过期或防重复编号冲突，不覆盖当前数据"
          },
          "422": {
            "description": "非法计划字段、非本机构或停用渠道、非草稿状态"
          },
          "500": {
            "description": "隔离环境后端错误时不返回业务数据"
          }
        }
      }
    },
    "/api/v1/marketing-campaigns/sales-reviews": {
      "get": {
        "operationId": "listScopedCampaignSalesReviews",
        "summary": "View own sales review requests and eligible pending manager reviews only",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Maximum 100 minimal permission-filtered review records; no evidence or finance data"
          },
          "403": {
            "description": "No approved signed employee or matching dedicated read LOGIN"
          },
          "500": {
            "description": "Fail closed if view results exceed the bounded size"
          }
        }
      }
    },
    "/api/v1/marketing-campaigns/drafts/{campaign_id}/sales-review-requests": {
      "post": {
        "operationId": "submitOwnCampaignForSalesReview",
        "summary": "Submit owner-owned draft version for independent sales review; no budget authorization",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "campaign_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expected_version",
                  "evidence_ref",
                  "reason_zh"
                ],
                "properties": {
                  "expected_version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 200
                  },
                  "reason_zh": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 400
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "pending_sales, no change to campaign draft or finance"
          },
          "403": {
            "description": "Only campaign owner with approved strict employee LOGIN can submit"
          },
          "409": {
            "description": "Stale version, already under review or conflicting idempotency key"
          },
          "422": {
            "description": "Invalid evidence or draft details"
          }
        }
      }
    },
    "/api/v1/marketing-campaigns/sales-reviews/{review_id}/decision": {
      "post": {
        "operationId": "decideIndependentSalesReview",
        "summary": "Independent active sales manager decides: approval remains on finance hold",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "review_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "decision",
                  "evidence_ref",
                  "reason_zh"
                ],
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "approved",
                      "rejected"
                    ]
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 200
                  },
                  "reason_zh": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 400
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "sales_approved_pending_finance or sales_rejected; campaign stays draft; finance_authorized=false"
          },
          "403": {
            "description": "Only different active same-institution sales manager"
          },
          "409": {
            "description": "Already reviewed, conflicting replay or stale campaign snapshot"
          },
          "422": {
            "description": "Invalid review decision or content"
          }
        }
      }
    },
    "/api/v1/marketing-campaigns/finance-handoffs": {
      "get": {
        "operationId": "listIsolatedCampaignFinanceHandoffs",
        "summary": "Only own/decided sales-approved records; read-only planning data, never finance approval",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "At most 100 scoped sales-approved handoff summaries; finance_authorized=false, execution_allowed=false; includes readiness_status with mismatch blockers, never finance approval"
          },
          "403": {
            "description": "Strict approved staff and dedicated read LOGIN required"
          },
          "500": {
            "description": "Oversized or unavailable projection fails closed"
          }
        }
      }
    },
    "/api/v1/marketing-campaigns/finance-incidents": {
      "get": {
        "operationId": "listIsolatedFinanceIncidents",
        "summary": "Employee-scoped sales-side incident records, never finance approval",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "100 or fewer minimal scoped records; no raw evidence"
          },
          "403": {
            "description": "Restricted staff identity required"
          },
          "500": {
            "description": "Fail closed on projection errors"
          }
        }
      }
    },
    "/api/v1/marketing-campaigns/finance-handoffs/{review_id}/incidents": {
      "post": {
        "operationId": "reportIsolatedFinanceIncident",
        "summary": "CI-only sales-side triage; no finance authorization",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "review_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "issue_kind",
                  "evidence_ref",
                  "reason_zh"
                ],
                "properties": {
                  "issue_kind": {
                    "type": "string",
                    "enum": [
                      "integrity_mismatch",
                      "supporting_materials_gap"
                    ]
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 200
                  },
                  "reason_zh": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 400
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Incident status only; finance_authorized=false"
          },
          "403": {
            "description": "Unapproved employee or self review"
          },
          "409": {
            "description": "Conflicting replay or active incident"
          },
          "422": {
            "description": "Invalid triage request"
          }
        }
      }
    },
    "/api/v1/marketing-campaigns/finance-incidents/{incident_id}/decision": {
      "post": {
        "operationId": "triageIsolatedFinanceIncident",
        "summary": "CI-only sales-side triage; no finance authorization",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "evidence_ref",
                  "reason_zh"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "escalate_manual",
                      "close_for_recheck"
                    ]
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 200
                  },
                  "reason_zh": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 400
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Incident status only; finance_authorized=false"
          },
          "403": {
            "description": "Unapproved employee or self review"
          },
          "409": {
            "description": "Conflicting replay or active incident"
          },
          "422": {
            "description": "Invalid triage request"
          }
        }
      }
    },
    "/api/v1/marketing-campaigns/finance-incidents/audit-history": {
      "get": {
        "operationId": "listScopedFinanceIncidentAuditHistory",
        "summary": "Read-only scoped incident chronology, immutable sales-side events only",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "At most 100 scoped incident events: registration, escalation and recheck, no raw JSON or evidence"
          },
          "403": {
            "description": "Approved strict staff-only read"
          },
          "500": {
            "description": "Fail closed on overlimit or invalid projection"
          }
        }
      }
    },
    "/api/v1/marketing-campaigns/finance-incidents/follow-ups": {
      "get": {
        "operationId": "listScopedFinanceEscalationFollowups",
        "summary": "Scoped metadata-only append-only records for manually escalated sales-side incidents",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Up to 100 scoped follow-up metadata items, no evidence or reason"
          },
          "403": {
            "description": "Approved staff-only read"
          },
          "500": {
            "description": "Fail closed on overlimit"
          }
        }
      }
    },
    "/api/v1/marketing-campaigns/finance-incidents/{incident_id}/follow-ups": {
      "post": {
        "operationId": "appendFinanceEscalationFollowup",
        "summary": "Append sales-side follow-up evidence; NEVER finance acceptance or release",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "note_type",
                  "evidence_ref",
                  "reason_zh"
                ],
                "additionalProperties": false,
                "properties": {
                  "note_type": {
                    "type": "string",
                    "enum": [
                      "sales_evidence_addendum",
                      "external_finance_requirements_pending"
                    ]
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 200
                  },
                  "reason_zh": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 400
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded append-only sales-side note; incident remains manual_escalated; finance_authorized=false"
          },
          "403": {
            "description": "Not reporter or original independent sales reviewer, not escalated, or employee revoked"
          },
          "409": {
            "description": "Same key used for different body"
          },
          "422": {
            "description": "Invalid note"
          }
        }
      }
    },
    "/api/v1/marketing-campaigns/finance-incidents/evidence-gates": {
      "get": {
        "operationId": "listIsolatedEscalationEvidenceGates",
        "summary": "Sales evidence completeness is never finance or academic acceptance; read-only",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "At most 100 minimal scoped escalation packets; finance and academic acceptance always false, hold remains active"
          },
          "403": {
            "description": "Strict authorized employee required"
          },
          "500": {
            "description": "Projection failure or overflow fail closed"
          }
        }
      }
    },
    "/api/v1/marketing-campaigns/finance-incidents/acceptance-prerequisites": {
      "get": {
        "operationId": "listCrossModuleAcceptancePrerequisites",
        "summary": "Strictly scoped read-only three-party prerequisites; no external finance or academic authority",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "At most 100 blocked prerequisite summaries. All external signed attestations false; hold_active=true, release_eligible=false."
          },
          "403": {
            "description": "Strict authorized employee only"
          },
          "500": {
            "description": "Read/overflow failure, no fallback"
          }
        }
      }
    },
    "/api/v1/marketing-campaigns/finance-incidents/trust-failure-gates": {
      "get": {
        "operationId": "listScopedCrossModuleTrustFailureGates",
        "summary": "Read-only external trust failures and compensation hard hold; not a signature verifier",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "At most 100 scoped blocked records. All signature, revocation, compensation and release flags false."
          },
          "403": {
            "description": "Strict staff and dedicated reader principal required"
          },
          "500": {
            "description": "Projection/overflow failure, fail closed"
          }
        }
      }
    }
  },
  "x-sales-approval-releases-budget": false,
  "x-finance-approval-implemented": false,
  "x-campaign-publishing-implemented": false,
  "x-finance-handoff-readonly": true,
  "x-finance-handoff-execution-allowed": false,
  "x-finance-readiness-does-not-authorize-spend": true,
  "x-finance-incidents-never-authorize-spend": true,
  "x-finance-incident-audit-readonly": true,
  "x-finance-incident-history-allows-spend": false,
  "x-escalation-followups-append-only": true,
  "x-external-finance-acceptance-implemented": false,
  "x-escalation-hold-can-be-released": false,
  "x-sales-evidence-not-cross-department-acceptance": true,
  "x-academic-acceptance-implemented": false,
  "x-finance-acceptance-implemented": false,
  "x-escalation-evidence-allows-hold-release": false,
  "x-cross-module-acceptance-protocol-status": "proposed-not-authorized",
  "x-finance-and-academic-trust-chains-established": false,
  "x-three-party-release-endpoint-implemented": false,
  "x-external-signature-verification-implemented": false,
